# URL base da API Flask existente. Ajuste conforme seu ambiente.
VITE_API_BASE_URL=http://localhost:8080

# Opcional apenas para desenvolvimento local, se o Flask exigir X-API-Key.
# Chaves VITE_* são incluídas no bundle do navegador e não são segredos de produção.
VITE_API_KEY=

# Versão exibida em Configurações (opcional).
VITE_APP_VERSION=1.0.0
