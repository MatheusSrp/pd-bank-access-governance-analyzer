# Modelo para Docker Compose. Python local NÃO lê .env: exporte as variáveis.
POSTGRES_DB=pd_bank
POSTGRES_USER=pd_bank
# TROQUE antes de usar. Somente letras/números/-/_ (a senha entra numa URL).
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=5432
API_PORT=8080
# Origem exata do navegador; múltiplas origens separadas por vírgula.
CORS_ORIGINS=http://localhost:5173
# Opcional: exige X-API-Key em /api/*, exceto /api/health.
API_KEY=
MAX_UPLOAD_MB=50
APP_TIMEZONE=America/Sao_Paulo
# Para Python local: DATABASE_URL=sqlite:///pd_bank_analyzer.db
# O Compose define DATABASE_URL para PostgreSQL no docker-compose.yml.
