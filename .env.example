# Copie para .env. Sem DATABASE_URL, a API local usa SQLite (pd_bank_analyzer.db).
# --- Docker Compose (PostgreSQL) ---
POSTGRES_DB=pd_bank
POSTGRES_USER=pd_bank
# Somente letras/números/-/_ (a senha entra numa URL). TROQUE antes de usar.
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_PORT=5432
API_PORT=8080
# --- Opcionais ---
# Origens permitidas para o frontend React (separe por vírgula). Vazio = CORS desligado.
CORS_ORIGINS=http://localhost:5173
# Se definido, /api/* (exceto /api/health) exige o cabeçalho X-API-Key.
API_KEY=
# Execução local sem Docker: DATABASE_URL=sqlite:///pd_bank_analyzer.db | MAX_UPLOAD_MB=50 | APP_TIMEZONE=America/Sao_Paulo

# Para frontend em porta 5173, configure CORS_ORIGINS=http://localhost:5173
